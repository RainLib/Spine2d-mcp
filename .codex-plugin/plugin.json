{
  "name": "spine-pipeline",
  "version": "0.2.0",
  "description": "Local Spine asset, mesh and animation tools with reusable game-production skills.",
  "author": { "name": "RainLib" },
  "homepage": "https://github.com/RainLib/Spine2d-mcp",
  "repository": "https://github.com/RainLib/Spine2d-mcp",
  "license": "MIT",
  "skills": "./skills/",
  "mcpServers": {
    "spine-pipeline": {
      "command": "uv",
      "args": ["run", "--locked", "--no-dev", "spine-pipeline-mcp"],
      "cwd": ".",
      "env_vars": [
        "SPINE_MCP_SOURCE_ROOT",
        "SPINE_MCP_STAGING_ROOT",
        "SPINE_MCP_CLI",
        "SPINE_MCP_CLI_VERSION",
        "SPINE_MCP_GODOT_EXECUTABLE"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    }
  },
  "interface": {
    "displayName": "Spine2d-mcp",
    "shortDescription": "Spine tools and game-production skills",
    "category": "Developer Tools",
    "composerIcon": "./docs/assets/brand/icon.png"
  }
}
